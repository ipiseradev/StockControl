@page "/register"
@layout BlankLayout
@using StockControl.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Crear cuenta - StockControl</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <h1>StockControl</h1>
        <p class="subtitle">Creá tu cuenta y empezá a controlar tu stock</p>

        <EditForm Model="modelo" OnValidSubmit="HandleRegister">
            <div class="field">
                <label>Nombre del comercio</label>
                <InputText @bind-Value="modelo.NombreComercio" />
            </div>
            <div class="field">
                <label>Tu nombre</label>
                <InputText @bind-Value="modelo.NombreUsuario" />
            </div>
            <div class="field">
                <label>Email</label>
                <InputText @bind-Value="modelo.Email" />
            </div>
            <div class="field">
                <label>Contraseña</label>
                <InputText type="password" @bind-Value="modelo.Password" />
            </div>

            @if (error is not null)
            {
                <p class="error">@error</p>
            }

            <button type="submit" disabled="@cargando">
                @(cargando ? "Creando cuenta..." : "Crear cuenta")
            </button>

            <div class="register-link">
                <p>¿Ya tenés cuenta? <a href="/login">Ingresá</a></p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RegisterModel modelo = new();
    private string? error;
    private bool cargando;

    private async Task HandleRegister()
    {
        cargando = true;
        error = null;

        try
        {
            var (exito, mensaje) = await AuthService.Register(modelo.NombreComercio, modelo.NombreUsuario, modelo.Email, modelo.Password);
            if (exito)
                Nav.NavigateTo("/");
            else
                error = mensaje ?? "No se pudo crear la cuenta.";
        }
        catch (Exception ex)
        {
            error = $"No se pudo conectar con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class RegisterModel
    {
        public string NombreComercio { get; set; } = string.Empty;
        public string NombreUsuario { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
