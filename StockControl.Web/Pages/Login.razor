@page "/login"
@layout BlankLayout
@using StockControl.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Ingresar - StockControl</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <h1>StockControl</h1>
        <p class="subtitle">Control de stock en tiempo real</p>

        <EditForm Model="modelo" OnValidSubmit="HandleLogin">
            <div class="field">
                <label>Email</label>
                <InputText @bind-Value="modelo.Email" />
            </div>
            <div class="field">
                <label>Contraseña</label>
                <InputText type="password" @bind-Value="modelo.Password" />
            </div>

            @if (error is not null)
            {
                <p class="error">@error</p>
            }

            <button type="submit" disabled="@cargando">
                @(cargando ? "Ingresando..." : "Ingresar")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel modelo = new();
    private string? error;
    private bool cargando;

    private async Task HandleLogin()
    {
        cargando = true;
        error = null;

        try
        {
            var ok = await AuthService.Login(modelo.Email, modelo.Password);
            if (ok)
                Nav.NavigateTo("/");
            else
                error = "Email o contraseña incorrectos.";
        }
        catch (Exception ex)
        {
            error = $"No se pudo conectar con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}