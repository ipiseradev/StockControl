@inherits LayoutComponentBase
@using StockControl.Web.Services
@inject AuthService AuthService
@inject RealtimeService Realtime
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (verificando)
{
    <div class="app-loading">Cargando...</div>
}
else
{
    <div class="mobile-topbar">
        <button class="menu-toggle" @onclick="AbrirMenu" aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </button>
        <div class="brand">StockControl</div>
    </div>

    @if (sidebarAbierta)
    {
        <div class="sidebar-backdrop" @onclick="CerrarMenu"></div>
    }

    <div class="app-shell">
        <aside class="sidebar @(sidebarAbierta ? "open" : "")">
            <div class="brand">Panel De Control</div>

            <div class="live-indicator">
                <span class="live-dot"></span>
                En vivo
            </div>

            <nav @onclick="CerrarMenu">
                <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                <NavLink href="/productos">Productos</NavLink>
                <NavLink href="/depositos">Depósitos</NavLink>
                <NavLink href="/movimientos">Movimientos</NavLink>
                <NavLink href="/alertas">Alertas</NavLink>
                <NavLink href="/usuarios">Usuarios</NavLink>
                @if (AuthService.EsAdmin)
                {
                    <NavLink href="/cuenta">Mi cuenta</NavLink>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="comercio-nombre">@AuthService.UsuarioActual?.NombreComercio</div>

                <button class="theme-toggle" @onclick="AlternarTema">
                    @if (temaOscuro)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                        <span>Modo claro</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.5A8.5 8.5 0 1 1 11.5 3a7 7 0 0 0 9.5 9.5Z" /></svg>
                        <span>Modo oscuro</span>
                    }
                </button>

                <button class="logout-btn" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        </aside>

        <main>
            @Body
        </main>
    </div>

    @if (toast is not null)
    {
        <div class="toast">@toast</div>
    }
}

@code {
    private bool verificando = true;
    private bool sidebarAbierta;
    private bool temaOscuro;
    private string? toast;
    private System.Threading.Timer? toastTimer;

    protected override async Task OnInitializedAsync()
    {
        var haySesion = await AuthService.CargarSesionGuardada();
        if (!haySesion)
        {
            Nav.NavigateTo("/login");
            return;
        }

        verificando = false;

        var temaGuardado = await JS.InvokeAsync<string?>("themeInterop.get");
        temaOscuro = temaGuardado == "dark";

        Nav.LocationChanged += OnLocationChanged;
        Realtime.StockActualizado += OnStockActualizado;
        await Realtime.ConectarAsync(AuthService.UsuarioActual!.TenantId);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CerrarMenu();
        InvokeAsync(StateHasChanged);
    }

    private void AbrirMenu() => sidebarAbierta = true;

    private void CerrarMenu() => sidebarAbierta = false;

    private async Task AlternarTema()
    {
        temaOscuro = !temaOscuro;
        await JS.InvokeVoidAsync("themeInterop.set", temaOscuro ? "dark" : "light");
    }

    private void OnStockActualizado(StockUpdate update)
    {
        toast = $"📦 {update.ProductoNombre}: stock actualizado a {update.StockActual}";
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            toast = null;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);

        InvokeAsync(StateHasChanged);
    }

    private async Task CerrarSesion()
    {
        await AuthService.Logout();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Realtime.StockActualizado -= OnStockActualizado;
        toastTimer?.Dispose();
    }
}
